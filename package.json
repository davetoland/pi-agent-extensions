{
	"name": "@davetoland/pi-agent-extensions",
	"version": "0.1.1",
	"description": "Custom extensions for the Pi coding agent",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/davetoland/pi-agent-extensions.git"
	},
	"engines": {
		"node": ">=22.5.0"
	},
	"scripts": {
		"test": "node --test context-pressure/test/logic.test.ts session-eval/test/test-digest.mjs tmux-agents/test.mjs"
	},
	"pi": {
		"extensions": [
			"./context-pressure/index.ts",
			"./custom-footer/index.ts",
			"./conditional-instructions/index.ts",
			"./skill-read-dedupe/index.ts",
			"./tmux-agents/index.ts",
			"./session-eval/index.ts"
		],
		"skills": [
			"./session-eval/evaluate-session"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0",
		"typebox": "^1.4.3"
	}
}
