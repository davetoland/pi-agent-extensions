{
  "name": "@davetoland/pi-agent-extensions",
  "version": "0.1.0",
  "description": "Custom extensions for the Pi coding agent",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davetoland/pi-agent-extensions.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test session-eval/test/test-digest.mjs tmux-agents/test.mjs"
  },
  "pi": {
    "extensions": [
      "./custom-footer/index.ts",
      "./conditional-instructions/index.ts",
      "./skill-read-dedupe/index.ts",
      "./tmux-agents/index.ts",
      "./session-eval/index.ts"
    ],
    "skills": ["./session-eval/evaluate-session"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
