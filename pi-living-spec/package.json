{
	"name": "pi-living-spec",
	"version": "0.1.2",
	"description": "Pi extension and skills for extracting, clarifying, and maintaining requirements specifications from prototypes.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"requirements",
		"playwright"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"playwright": "^1.52.0",
		"typescript": "^5.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"files": [
		"src",
		"skills",
		"tsconfig.json",
		"README.md",
		"DESIGN.md",
		"CHANGELOG.md"
	]
}
